# Copy this file to local.env and fill in absolute paths to legally obtained
# local files. local.env is ignored by Git.

# Configure either or both ROMs. The generator requires at least one.
# The certified revisions are A1200 Kickstart 3.0/39.106 and 3.1/40.068.
MIGA80_KICKSTART_30=""
MIGA80_KICKSTART_30_SHA256=""
MIGA80_KICKSTART_31=""
MIGA80_KICKSTART_31_SHA256=""

# The HD profiles are generated only when the matching system directory or
# HDF exists. Directory-backed systems are preferred for the first dev loop.
MIGA80_WORKBENCH_30=""
MIGA80_WORKBENCH_31=""

# The ADF profiles are generated only when this image exists.
MIGA80_ADF=""

# A directory mounted as the second Amiga drive by HD profiles.
MIGA80_STAGING_DIR="/absolute/path/to/OS-MIGA-80/build/staging"
